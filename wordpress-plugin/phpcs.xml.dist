<?xml version="1.0"?>
<ruleset name="agentprose">
	<description>WordPress Coding Standards for the agentprose plugin.</description>
	<file>agentprose</file>
	<exclude-pattern>agentprose/js/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.3"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="agentprose"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="agentprose"/></property>
		</properties>
	</rule>
</ruleset>
