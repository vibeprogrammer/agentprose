{
  "name": "agentprose-website",
  "private": true,
  "type": "module",
  "description": "Documentation site for agentprose (Astro + Starlight), deployed to GitHub Pages.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build && node scripts/agent-index.mjs",
    "preview": "astro preview",
    "check:links": "node scripts/check-links.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "agentprose": "^0.1.3",
    "astro": "^7.4.1",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "starlight-typedoc": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "playwright-core": "^1.56.0"
  }
}
