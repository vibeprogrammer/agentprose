---
import Default from '@astrojs/starlight/components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Default><slot /></Default>
<div class="ap-footer">
  <p>
    <a href="https://github.com/webmaxru/agentprose">GitHub</a>
    <span aria-hidden="true">·</span>
    <a href="https://www.npmjs.com/package/agentprose">npm</a>
    <span aria-hidden="true">·</span>
    <a href="https://agentprose.cloud">agentprose Cloud</a>
    <span aria-hidden="true">·</span>
    <a href={`${base}project/changelog/`}>Changelog</a>
  </p>
  <p>MIT licensed. The core, every tool, the CLI, all adapters and the WordPress plugin stay free and open source.</p>
</div>
<style>
  .ap-footer { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--sl-color-hairline); font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .ap-footer p { margin: 0.25rem 0; }
  .ap-footer a { color: var(--sl-color-gray-2); text-decoration: none; }
  .ap-footer a:hover { color: var(--sl-color-accent-high); text-decoration: underline; }
  .ap-footer span { margin: 0 0.35rem; }
</style>
